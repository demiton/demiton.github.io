---
import '@fontsource/anton';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/custom.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
	title: string;
	description: string;
	/** Header transparent, posé sur un hero plein cadre (page d'accueil) :
	 * il ne prend un fond noir qu'une fois qu'on a défilé la page. */
	transparentHeader?: boolean;
	/** Ajoute « — Demiton » au titre de l'onglet. À passer à `false` quand
	 * `title` contient déjà le nom du site (page d'accueil), pour éviter
	 * un libellé redondant. */
	appendSiteName?: boolean;
	/** Image de partage. Par défaut la carte générique du site. */
	ogImage?: string;
	/** `article` pour les pages de contenu, `website` pour les autres. */
	ogType?: 'website' | 'article';
}

const {
	title,
	description,
	transparentHeader = false,
	appendSiteName = true,
	ogImage = '/og-default.jpg',
	ogType = 'website',
} = Astro.props;

/* Compose le titre une seule fois ici : le passer déjà concaténé depuis la
   page exposerait les entités HTML du source (« &amp; ») à un double
   échappement par Astro. */
const pageTitle = appendSiteName ? `${title} — Demiton` : title;

/* Les URL absolues sont exigées : les robots d'indexation comme les
   plateformes de partage refusent un chemin relatif. `Astro.site` provient de
   `site` dans astro.config.mjs ; le repli couvre le cas où il serait absent. */
const site = Astro.site ?? new URL('https://demiton.github.io');
const canonical = new URL(Astro.url.pathname, site).href;

/* Toutes les couvertures d'articles ne conviennent pas au partage : la plupart
   sont des SVG, qu'aucune grande plateforme ne rend, ce qui produirait un
   aperçu vide. On retombe alors sur la carte générique du site. Une URL
   externe est acceptée telle quelle (les paramètres de requête empêchent d'en
   déduire l'extension). */
const externe = /^https?:\/\//i.test(ogImage);
const raster = /\.(png|jpe?g|webp|gif)$/i.test(ogImage.split('?')[0]);
const shareImage = new URL(externe || raster ? ogImage : '/og-default.jpg', site).href;
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" />

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Demiton" />
		<meta property="og:locale" content="fr" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={shareImage} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImage} />
	</head>
	<body>
		<header class="page-header" data-transparent={transparentHeader ? '' : undefined}>
			<SiteHeader />
		</header>
		<main>
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>

{
	transparentHeader && (
		<script>
			const header = document.querySelector<HTMLElement>('.page-header[data-transparent]');
			if (header) {
				const onScroll = () => header.classList.toggle('is-solid', window.scrollY > 40);
				onScroll();
				addEventListener('scroll', onScroll, { passive: true });
			}
		</script>
	)
}

<style is:global>
	:root {
		color-scheme: dark;
	}

	body {
		margin: 0;
		background: var(--color-bg);
		color: var(--color-ink);
		font-family: var(--font-body);
	}

	main {
		display: flex;
		flex-direction: column;
	}
</style>

<style>
	.page-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-hairline);
		padding: 1.25rem 3rem; /* 20px 48px, maquette « Header » */
	}

	/* Accueil : le header flotte, transparent, sur le hero plein cadre —
	   il ne devient une barre noire qu'au défilement. */
	.page-header[data-transparent] {
		position: fixed;
		inset-inline: 0;
		background: transparent;
		border-bottom-color: transparent;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.page-header[data-transparent].is-solid {
		background: var(--color-surface);
		border-bottom-color: var(--color-hairline);
	}

	@media (max-width: 50rem) {
		.page-header {
			padding: 1rem 1.25rem; /* 16px 20px, maquette « Mobile Header » */
		}

		/* Maquette mobile : le header est le premier élément en flux, en bloc
		   solide — il ne flotte plus au-dessus du hero. On annule donc le mode
		   transparent, mais on garde le `sticky` pour qu'il reste accessible. */
		.page-header[data-transparent] {
			position: sticky;
			background: var(--color-surface);
			border-bottom-color: var(--color-hairline);
		}
	}
</style>
