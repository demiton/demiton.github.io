---
// Header du site : utilisé à la fois comme override du `Header` Starlight
// (pages de doc) et directement dans `SiteLayout` (accueil, blog, article),
// pour une nav identique partout.
import { Icon } from '@astrojs/starlight/components';
import Search from 'virtual:starlight/components/Search';
import config from 'virtual:starlight/user-config';

const shouldRenderSearch = config.pagefind;

const navItems = [
	{ label: 'Docs', href: '/guides/bien-demarrer/' },
	{ label: 'Blog', href: '/blog/', accent: true },
	{ label: 'À propos', href: '/a-propos/' },
	{ label: 'Contact', href: '/contact/' },
];
---

<div class="site-header">
	<a class="brand" href="/">Demiton</a>

	<nav class="nav" aria-label="Navigation principale">
		{
			navItems.map((item) => (
				<a href={item.href} class:list={['nav-link', { accent: item.accent }]}>
					{item.label}
				</a>
			))
		}
		{shouldRenderSearch && <Search />}
	</nav>

	<button class="menu-toggle" popovertarget="site-mobile-nav" aria-label="Ouvrir le menu">
		<Icon name="bars" size="1.125rem" />
	</button>

	<nav id="site-mobile-nav" popover class="mobile-nav" aria-label="Navigation principale (mobile)">
		{
			navItems.map((item) => (
				<a href={item.href} class:list={['nav-link', { accent: item.accent }]}>
					{item.label}
				</a>
			))
		}
	</nav>
</div>

<!-- Source unique des liens du menu : le script ci-dessous clone ce contenu
     dans la navigation de documentation, pour ne pas dupliquer la liste. -->
<template id="site-nav-links">
	{
		navItems.map((item) => (
			<a href={item.href} class:list={[{ accent: item.accent }]}>{item.label}</a>
		))
	}
</template>

<script>
	// En page de documentation, le bouton de menu affiché est celui de Starlight
	// (il ouvre l'arbre des guides et des notes). On y ajoute les liens du site,
	// sinon Blog, À propos et Contact deviendraient inatteignables sur mobile
	// puisque le bouton du SiteHeader y est masqué (voir le style plus bas).
	const sidebar = document.getElementById('starlight__sidebar');
	const template = document.getElementById('site-nav-links');

	if (sidebar instanceof HTMLElement && template instanceof HTMLTemplateElement) {
		if (!sidebar.querySelector('.doc-menu-site-nav')) {
			const nav = document.createElement('nav');
			nav.className = 'doc-menu-site-nav';
			nav.setAttribute('aria-label', 'Navigation du site');
			nav.append(template.content.cloneNode(true));
			sidebar.prepend(nav);
		}
	}
</script>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		width: 100%;
		height: 100%;
	}

	.brand {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.375rem; /* 22px, maquette « Header » */
		color: var(--color-ink);
		text-decoration: none;
		white-space: nowrap;
	}

	.nav {
		display: none;
		align-items: center;
		gap: 1.75rem; /* 28px, maquette */
	}

	.nav-link {
		font-family: var(--font-body);
		font-size: 0.875rem; /* 14px */
		font-weight: 400; /* seul « Blog » est en 500 (maquette) */
		color: var(--color-ink-2);
		text-decoration: none;
		white-space: nowrap;
	}

	.nav-link:hover {
		color: var(--color-ink);
	}

	.nav-link.accent {
		color: var(--color-accent);
		font-weight: 500;
	}

	.menu-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem; /* 36×36, maquette « Mobile Header » */
		height: 2.25rem;
		border-radius: 8px;
		border: none; /* la maquette ne prévoit pas de bordure */
		background: var(--color-bg);
		color: var(--color-ink);
		cursor: pointer;
	}

	/* [popover] est masqué par défaut par la feuille de style du
	   navigateur (display: none) ; on ne force l'affichage flex que
	   lorsqu'il est effectivement ouvert, sinon le panneau reste
	   visible en permanence. */
	.mobile-nav {
		flex-direction: column;
		gap: 0.25rem;
		position: fixed;
		inset-inline: 1rem;
		top: 4.5rem;
		margin: 0;
		padding: 0.75rem;
		border-radius: 12px;
		border: 1px solid var(--color-hairline);
		background: var(--color-surface);
	}

	.mobile-nav:popover-open {
		display: flex;
	}

	.mobile-nav .nav-link {
		padding: 0.6rem 0.75rem;
		border-radius: 8px;
	}

	.mobile-nav .nav-link:hover {
		background: var(--color-bg);
	}

	@media (max-width: 50rem) {
		/* Maquette « Mobile Header » : marque en 18px. */
		.brand {
			font-size: 1.125rem;
		}
	}

	@media (min-width: 50rem) {
		.nav {
			display: flex;
		}

		.menu-toggle {
			display: none;
		}
	}

	/* En page de documentation, Starlight affiche déjà son propre bouton de menu
	   sous 50rem — c'est lui qui ouvre l'arbre des guides et des notes, et il est
	   restylé aux tokens du site dans custom.css. On masque donc le nôtre pour ne
	   conserver qu'un seul bouton, comme sur la maquette : sans cela, deux boutons
	   de menu cohabitent en haut à droite (Starlight place le sien en `fixed`,
	   juste à droite du nôtre). */
	@media (max-width: 49.999rem) {
		:global(body:has(.sl-menu-button)) .menu-toggle {
			display: none;
		}
	}
</style>
