---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
		(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
	);

	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			prev: posts[index + 1],
			next: posts[index - 1],
		},
	}));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));
---

<SiteLayout title={post.data.title} description={post.data.description} transparentHeader>
	<article>
		<header class="hero" style={`background-image: url(${post.data.cover})`}>
			<div class="overlay"></div>
			<div class="hero-content">
				<p class="breadcrumb">
					<a href="/blog/">Blog</a> / {post.data.title}
				</p>
				<div class="meta-top">
					<span class="category">{post.data.category}</span>
					<span class="date">{post.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
				</div>
				<h1>{post.data.title}</h1>
				<p class="reading-time">{readingTime} min de lecture</p>
			</div>
		</header>

		<div class="body-wrap">
			<div class="prose">
				<Content />
			</div>

			{
				post.data.tags.length > 0 && (
					<div class="tags">
						{post.data.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				)
			}

			{
				(prev || next) && (
					<nav class="prev-next" aria-label="Navigation entre articles">
						{prev ? (
							<a href={`/blog/${prev.id}/`} class="nav-card">
								<div class="thumb" style={`background-image: url(${prev.data.cover})`} />
								<span class="text">
									<span class="eyebrow">← Précédent</span>
									<span class="title">{prev.data.title}</span>
								</span>
							</a>
						) : (
							<span />
						)}
						{next && (
							<a href={`/blog/${next.id}/`} class="nav-card align-end">
								<span class="text">
									<span class="eyebrow accent">Suivant →</span>
									<span class="title">{next.data.title}</span>
								</span>
								<div class="thumb" style={`background-image: url(${next.data.cover})`} />
							</a>
						)}
					</nav>
				)
			}
		</div>
	</article>
</SiteLayout>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 37.5rem; /* 600px : maquette « Article de blog » (26rem auparavant) */
		overflow: clip;
		background-size: cover;
		background-position: center;
	}

	.overlay {
		position: absolute;
		inset: 0;
		background: #08080adb; /* voile à 86 %, valeur de la maquette */
	}

	.hero-content {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		max-width: 48rem;
		padding: 6rem 3rem 3rem;
		text-align: center;
	}

	.breadcrumb {
		margin: 0;
		font-size: 0.75rem;
		color: var(--color-ink-2);
	}

	.breadcrumb a {
		color: var(--color-ink-2);
	}

	.meta-top {
		display: flex;
		align-items: center;
		gap: 0.875rem;
	}

	.category {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		color: var(--color-accent);
		background: var(--color-accent-soft);
		border-radius: 999px;
		padding: 0.3rem 0.85rem;
	}

	.date {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-ink-2);
	}

	.hero-content h1 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		color: var(--color-ink);
	}

	.reading-time {
		margin: 0;
		font-size: 0.8rem;
		color: var(--color-ink-2);
	}

	.body-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 2.5rem 3rem 5rem;
	}

	.prose {
		width: 100%;
		max-width: 47.5rem;
		line-height: 1.8;
		color: var(--color-ink-2);
	}

	.prose :global(h2) {
		color: var(--color-ink);
		margin-top: 2rem;
	}

	.prose :global(a) {
		color: var(--color-accent);
	}

	.prose :global(code) {
		font-family: var(--font-mono);
		color: var(--sl-color-text-accent);
	}

	.prose :global(pre) {
		background: var(--color-code-bg);
		border: 1px solid var(--color-hairline);
		border-radius: 12px;
		padding: 1rem;
	}

	.tags {
		display: flex;
		gap: 0.6rem;
		margin: 2.5rem auto 0;
		max-width: 47.5rem;
	}

	.tag {
		font-size: 0.75rem;
		color: var(--color-ink-2);
		border: 1px solid var(--color-hairline);
		border-radius: 999px;
		padding: 0.35rem 0.85rem;
	}

	.prev-next {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
		margin: 2.5rem auto 0;
		max-width: 47.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-hairline);
	}

	.nav-card {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 0.85rem;
		border-radius: 8px;
		border: 1px solid var(--color-hairline);
		background: var(--color-surface);
		text-decoration: none;
	}

	.nav-card.align-end {
		flex-direction: row-reverse;
		text-align: right;
	}

	.nav-card .thumb {
		flex-shrink: 0;
		width: 56px;
		height: 56px;
		border-radius: 6px;
		background-size: cover;
		background-position: center;
	}

	.nav-card .text {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.nav-card.align-end .text {
		align-items: flex-end;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--color-ink-2);
	}

	.eyebrow.accent {
		color: var(--color-accent);
	}

	.title {
		font-family: var(--font-display);
		font-weight: 400;
		color: var(--color-ink);
	}

	@media (max-width: 40rem) {
		.prev-next {
			grid-template-columns: 1fr;
		}
	}
</style>
