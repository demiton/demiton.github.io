---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
		(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
	);

	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			prev: posts[index + 1],
			next: posts[index - 1],
		},
	}));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);

/* Sommaire : les articles de fond ont au moins trois sections de niveau 2.
   En dessous, un sommaire encombrerait plus qu'il n'aide. */
const sommaire = headings.filter((heading) => heading.depth === 2);

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));

/* Maquette « Article de blog » : date abrégée en capitales (« 12 SEPT. 2026 »).
   Le point vient déjà de l'abréviation française, on ne le retire donc pas. */
const formattedDate = post.data.date
	.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })
	.toUpperCase();
---

<SiteLayout
	title={post.data.title}
	description={post.data.description}
	ogImage={post.data.cover}
	ogType="article"
	transparentHeader
>
	<article>
		<header class="hero" style={`--hero-cover: url(${post.data.cover})`}>
			<div class="overlay"></div>
			<div class="hero-content">
				<p class="breadcrumb">
					<a href="/blog/">Blog</a> / {post.data.title}
				</p>
				<div class="meta-top">
					<span class="category">{post.data.category}</span>
					<span class="date">{formattedDate}</span>
					<span class="separator" aria-hidden="true">·</span>
					<span class="reading-time">{readingTime} min de lecture</span>
				</div>
				<h1>{post.data.title}</h1>
			</div>
		</header>

		<!-- Maquette « Article de blog (mobile) » : la couverture quitte le hero
		     plein cadre et devient une image posée sous un bloc d'en-tête solide. -->
		<div class="cover-wrap">
			<img class="cover" src={post.data.cover} alt="" />
		</div>

		<div class="body-wrap">
			{
				sommaire.length >= 3 && (
					<nav class="sommaire" aria-label="Sommaire de l'article">
						<p class="sommaire-title">Au sommaire</p>
						<ol>
							{sommaire.map((heading) => (
								<li>
									<a href={`#${heading.slug}`}>{heading.text}</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}
			<div class="prose">
				<Content />
			</div>

			{
				post.data.tags.length > 0 && (
					<div class="tags">
						{post.data.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				)
			}

			{
				(prev || next) && (
					<nav class="prev-next" aria-label="Navigation entre articles">
						{prev ? (
							<a href={`/blog/${prev.id}/`} class="nav-card">
								<div class="thumb" style={`background-image: url(${prev.data.cover})`} />
								<span class="text">
									<span class="eyebrow">← Précédent</span>
									<span class="title">{prev.data.title}</span>
								</span>
							</a>
						) : (
							<span />
						)}
						{next && (
							<a href={`/blog/${next.id}/`} class="nav-card align-end">
								<span class="text">
									<span class="eyebrow">Suivant →</span>
									<span class="title">{next.data.title}</span>
								</span>
								<div class="thumb" style={`background-image: url(${next.data.cover})`} />
							</a>
						)}
					</nav>
				)
			}
		</div>
	</article>
</SiteLayout>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 37.5rem; /* 600px : maquette « Article de blog » (26rem auparavant) */
		overflow: clip;
		/* La couverture passe par une variable plutôt que par un style inline :
		   sur mobile la maquette la détache du hero, ce qu'un `background-image`
		   inline rendrait impossible à annuler sans `!important`. */
		background-image: var(--hero-cover);
		background-size: cover;
		background-position: center;
	}

	/* Couverture détachée du hero : n'apparaît que sur mobile (maquette). */
	.cover-wrap {
		display: none;
	}

	.overlay {
		position: absolute;
		inset: 0;
		/* Voile uniforme fortement réduit (la maquette prescrivait 86 %). */
		background: #08080a4d; /* 30 % */
		z-index: 0;
	}

	/* Comme sur l'accueil, l'image reste lumineuse et seules les zones portant
	   du texte sont assombries : la bande du header et le bloc central, où le
	   fil d'Ariane et la ligne méta sont en petits caractères. */
	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			linear-gradient(to bottom, rgb(8 8 10 / 80%) 0%, rgb(8 8 10 / 0%) 24%),
			radial-gradient(ellipse 60% 66% at 50% 56%, rgb(8 8 10 / 62%) 0%, rgb(8 8 10 / 0%) 76%);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		max-width: 48rem;
		padding: 6rem 3rem 3rem;
		text-align: center;
	}

	.breadcrumb {
		margin: 0;
		font-size: 0.75rem;
		color: var(--color-ink-2);
		/* Petits caractères posés sur la couverture : l'ombre les rend lisibles
		   sans qu'il faille densifier le voile sur toute l'image. */
		text-shadow: 0 1px 4px rgb(8 8 10 / 90%);
	}

	.breadcrumb a {
		color: var(--color-ink-2);
	}

	.meta-top {
		display: flex;
		align-items: center;
		gap: 0.875rem; /* 14px, maquette */
		text-shadow: 0 1px 4px rgb(8 8 10 / 90%);
	}

	.category {
		font-family: var(--font-mono);
		font-size: 0.6875rem; /* 11px */
		font-weight: 600;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: var(--color-accent);
		background: var(--color-accent-soft);
		border-radius: 999px;
		padding: 0.3125rem 0.875rem; /* 5px 14px */
	}

	.date {
		font-family: var(--font-mono);
		font-size: 0.75rem; /* 12px */
		color: var(--color-ink-2);
	}

	.separator {
		color: var(--color-ink-2);
	}

	.hero-content h1 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		color: var(--color-ink);
	}

	.reading-time {
		margin: 0;
		font-size: 0.75rem; /* 12px */
		color: var(--color-ink-2);
	}

	/* Maquette « Article de blog (mobile) » : le hero plein cadre laisse place à
	   un bloc d'en-tête solide et aligné à gauche, suivi de la couverture
	   détachée. Le `h1` est déjà à 28px à cette largeur via son `clamp`. */
	@media (max-width: 50rem) {
		.hero {
			display: block;
			min-height: 0;
			background-image: none;
			background-color: var(--color-surface);
			border-bottom: 1px solid var(--color-hairline);
		}

		/* Plus de couverture plein cadre : ni voile ni vignette. */
		.overlay,
		.hero::after {
			display: none;
		}

		.hero-content {
			align-items: flex-start;
			text-align: left;
			gap: 0.75rem; /* 12px */
			max-width: none;
			padding: 1.75rem 1.25rem 1.5rem; /* 28px 20px 24px */
		}

		.cover-wrap {
			display: block;
			padding: 1.25rem 1.25rem 0; /* 20px 20px 0 */
		}

		.cover {
			display: block;
			width: 100%;
			height: 12.5rem; /* 200px */
			object-fit: cover;
			border-radius: 10px;
		}
	}

	.body-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 2.5rem 3rem 5rem;
	}

	.prose {
		width: 100%;
		max-width: 47.5rem;
		line-height: 1.8;
		color: var(--color-ink-2);
	}

	.prose :global(h2) {
		color: var(--color-ink);
		margin-top: 2rem;
	}

	.prose :global(a) {
		color: var(--color-accent);
	}

	.prose :global(code) {
		font-family: var(--font-mono);
		color: var(--sl-color-text-accent);
	}

	.prose :global(pre) {
		background: var(--color-code-bg);
		border: 1px solid var(--color-hairline);
		border-radius: 12px;
		padding: 1rem;
	}

	/* ============================================================
	   Architecture éditoriale des articles de fond
	   Chapeau, sommaire, schémas, encadrés pédagogiques, tableaux
	   comparatifs et sources en notes de bas de page.
	   ============================================================ */

	/* Chapeau : le premier paragraphe porte l'accroche, il est donc mis en
	   avant — encre pleine et corps légèrement plus grand. */
	.prose :global(p:first-of-type) {
		font-size: 1.0625rem;
		color: var(--color-ink);
	}

	.prose :global(h3) {
		margin: 2.25rem 0 0.5rem;
		font-size: 1.25rem;
		color: var(--color-ink);
	}

	.prose :global(h4) {
		margin: 1.5rem 0 0.4rem;
		color: var(--color-ink);
	}

	.prose :global(li) {
		margin-bottom: 0.45rem;
	}

	/* Schémas et illustrations : cadre discret, légende en petit corps. */
	.prose :global(figure) {
		margin: 2rem 0;
	}

	.prose :global(figure img) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--color-hairline);
		border-radius: 12px;
		background: var(--color-surface);
	}

	.prose :global(figcaption) {
		margin-top: 0.6rem;
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--color-ink-2);
	}

	/* Encadrés pédagogiques (« En clair », « À retenir »). Le libellé est le
	   premier mot en gras du bloc : il est mis en forme comme un sur-titre. */
	.prose :global(blockquote) {
		margin: 1.75rem 0;
		padding: 1rem 1.25rem;
		border: 1px solid var(--color-hairline);
		border-left: 3px solid var(--color-cyan);
		border-radius: 0 8px 8px 0;
		background: var(--color-surface);
		color: var(--color-ink);
	}

	.prose :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.prose :global(blockquote p:first-child strong:first-child) {
		display: block;
		margin-bottom: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: var(--color-cyan);
	}

	/* Tableaux comparatifs */
	.prose :global(table) {
		width: 100%;
		margin: 1.75rem 0;
		border-collapse: collapse;
		font-size: 0.875rem;
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 0.6rem 0.75rem;
		border-bottom: 1px solid var(--color-hairline);
		text-align: left;
		vertical-align: top;
	}

	.prose :global(th) {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		color: var(--color-ink);
	}

	.prose :global(hr) {
		margin: 2.5rem 0;
		border: none;
		border-top: 1px solid var(--color-hairline);
	}

	/* Sources : section produite par les notes de bas de page de remark-gfm. */
	.prose :global(.footnotes) {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-hairline);
		font-size: 0.8125rem;
		line-height: 1.7;
	}

	.prose :global(.footnotes h2) {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: var(--color-ink-2);
	}

	.prose :global(.footnotes ol) {
		padding-left: 1.25rem;
	}

	.prose :global(.footnotes li) {
		margin-bottom: 0.5rem;
	}

	.prose :global(.footnotes a) {
		overflow-wrap: anywhere;
	}

	.prose :global(sup a) {
		text-decoration: none;
	}

	/* Sommaire : hors du corps de texte, aligné sur sa largeur de lecture. */
	.sommaire {
		width: 100%;
		max-width: 47.5rem;
		margin: 0 auto 2.5rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--color-hairline);
		border-radius: 12px;
		background: var(--color-surface);
	}

	.sommaire-title {
		margin: 0 0 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: var(--color-ink-2);
	}

	.sommaire ol {
		margin: 0;
		padding-left: 1.1rem;
		columns: 2;
		column-gap: 2rem;
		font-size: 0.9375rem;
	}

	.sommaire li {
		margin: 0 0 0.35rem;
	}

	.sommaire a {
		color: var(--color-ink);
		text-decoration: none;
	}

	.sommaire a:hover {
		color: var(--color-accent);
	}

	@media (max-width: 50rem) {
		/* Sur mobile, le sommaire passe sur une colonne : deux colonnes de
		   titres tronqués se lisent mal à 390 px. */
		.sommaire ol {
			columns: 1;
		}
	}

	.tags {
		display: flex;
		gap: 0.625rem; /* 10px, maquette */
		margin: 2.5rem auto 0;
		max-width: 47.5rem;
	}

	.tag {
		font-size: 0.75rem;
		color: var(--color-ink-2);
		background: var(--color-surface);
		border: 1px solid var(--color-hairline);
		border-radius: 999px;
		padding: 0.375rem 0.875rem; /* 6px 14px */
	}

	/* La maquette ne sépare pas les cartes prev/next du corps par un filet :
	   chaque carte porte sa propre bordure. */
	.prev-next {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem; /* 20px */
		margin: 2.5rem auto 0;
		max-width: 47.5rem;
	}

	.nav-card {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 0.85rem;
		border-radius: 8px;
		border: 1px solid var(--color-hairline);
		background: var(--color-surface);
		text-decoration: none;
	}

	.nav-card.align-end {
		flex-direction: row-reverse;
		text-align: right;
	}

	.nav-card .thumb {
		flex-shrink: 0;
		width: 56px;
		height: 56px;
		border-radius: 6px;
		background-size: cover;
		background-position: center;
	}

	.nav-card .text {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.nav-card.align-end .text {
		align-items: flex-end;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.625rem; /* 10px, maquette */
		font-weight: 600;
		letter-spacing: 1px;
		text-transform: uppercase;
		/* La maquette met « ← PRÉCÉDENT » et « SUIVANT → » dans le même gris. */
		color: var(--color-ink-2);
	}

	.title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.875rem; /* 14px */
		color: var(--color-ink);
	}

	@media (max-width: 50rem) {
		/* Maquette « Article de blog (mobile) » : corps et cartes resserrés. */
		.body-wrap {
			gap: 1.25rem; /* 20px */
			padding: 1.5rem 1.25rem 2.5rem; /* 24px 20px 40px */
		}

		.prose {
			font-size: 0.875rem; /* 14px */
		}

		.prose :global(h2) {
			font-size: 1.25rem; /* 20px */
		}

		.prev-next {
			gap: 0.75rem; /* 12px */
		}

		.nav-card {
			padding: 0.75rem; /* 12px */
		}

		.nav-card .thumb {
			width: 48px;
			height: 48px;
		}
	}

	@media (max-width: 40rem) {
		.prev-next {
			grid-template-columns: 1fr;
		}
	}
</style>
