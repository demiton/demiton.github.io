---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPathsOptions, Page } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

type Post = CollectionEntry<'blog'>;

/** Props de la route paginée. Sans cette déclaration, `Astro.props` est inféré
 * en `never` et tous les accès à `page.*` échouent au typage. */
interface Props {
	page: Page<Post>;
}

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
	// `getStaticPaths` est hissé par Astro dans un module distinct : il ne peut
	// pas appeler une fonction déclarée dans le frontmatter, d'où la requête
	// répétée ici plutôt que factorisée.
	const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
		(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
	);

	// L'article le plus récent est mis en avant de façon permanente (section
	// distincte, hors pagination) ; la grille qui suit est paginée par 6, soit
	// 3 rangées de 2 cartes comme sur la maquette « Blog ».
	const [, ...rest] = posts;
	return paginate(rest, { pageSize: 6 });
}

const { page } = Astro.props;

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const [featured] = allPosts;

// Les widgets décrivent l'ensemble du blog, pas la page courante.
const categories = [...new Map(allPosts.map((p) => [p.data.category, p.data.category])).values()].map(
	(category) => ({
		category,
		count: allPosts.filter((p) => p.data.category === category).length,
	})
);

const tags = [...new Set(allPosts.flatMap((p) => p.data.tags))];

/** URL d'une page numérotée. La première vit à la racine du blog. */
const pageHref = (n: number) => (n === 1 ? '/blog/' : `/blog/${n}/`);
const totalPages = page.lastPage;
---

<SiteLayout title="Blog" description="Articles, tutoriels et retours d'expérience.">
	<section class="title-section">
		<h1>Blog</h1>
		<p>Articles, tutoriels et retours d'expérience.</p>
	</section>

	{
		featured && page.currentPage === 1 && (
			<section class="featured-wrap">
				<a class="featured-card" href={`/blog/${featured.id}/`}>
					<div class="cover" style={`background-image: url(${featured.data.cover})`} />
					<div class="body">
						<span class="eyebrow">
							À LA UNE —{' '}
							{featured.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).toUpperCase()}
						</span>
						<h2>{featured.data.title}</h2>
						<p>{featured.data.description}</p>
						<span class="cta">Lire l'article</span>
					</div>
				</a>
			</section>
		)
	}

	<section class="body-grid">
		<div class="content-col">
			<h2 class="section-title">Articles récents</h2>
			{page.data.length === 0 && <p class="empty">D'autres articles arrivent bientôt.</p>}
			<div class="article-grid">
				{
					page.data.map((post) => (
						<ArticleCard
							href={`/blog/${post.id}/`}
							title={post.data.title}
							excerpt={post.data.description}
							cover={post.data.cover}
							category={post.data.category}
							date={post.data.date}
						/>
					))
				}
			</div>
		</div>
		<aside class="sidebar">
			<div class="widget">
				<h3>Catégories</h3>
				<ul>
					{categories.map(({ category, count }) => (
						<li>
							<span>{category}</span>
							<span class="count">{count}</span>
						</li>
					))}
				</ul>
			</div>
			<div class="widget">
				<h3>Tags</h3>
				<div class="tag-cloud">
					{tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</div>
			</div>
		</aside>
	</section>

	{
		totalPages > 1 && (
			<nav class="pagination" aria-label="Pagination du blog">
				{page.url.prev ? (
					<a class="page-link" href={page.url.prev} rel="prev">
						←<span class="label"> Précédent</span>
					</a>
				) : (
					<span class="page-link is-disabled">
						←<span class="label"> Précédent</span>
					</span>
				)}

				{Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
					<a
						class:list={['page-number', { current: n === page.currentPage }]}
						href={pageHref(n)}
						aria-current={n === page.currentPage ? 'page' : undefined}
					>
						{n}
					</a>
				))}

				{page.url.next ? (
					<a class="page-link" href={page.url.next} rel="next">
						<span class="label">Suivant </span>→
					</a>
				) : (
					<span class="page-link is-disabled">
						<span class="label">Suivant </span>→
					</span>
				)}
			</nav>
		)
	}
</SiteLayout>

<style>
	.title-section {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		padding: 4rem 3rem 3rem;
		text-align: center;
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-hairline);
	}

	.title-section h1 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 2.5rem;
	}

	.title-section p {
		margin: 0;
		color: var(--color-ink-2);
	}

	.featured-wrap {
		padding: 2.5rem 3rem 0;
	}

	.featured-card {
		display: flex;
		flex-direction: column;
		overflow: clip;
		border-radius: 8px;
		border: 1px solid var(--color-hairline);
		background: var(--color-surface);
		text-decoration: none;
		color: inherit;
	}

	.featured-card .cover {
		width: 100%;
		height: 340px;
		background-size: cover;
		background-position: center;
	}

	.featured-card .body {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 2.5rem;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-accent);
	}

	.featured-card h2 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.75rem;
	}

	.featured-card p {
		margin: 0;
		color: var(--color-ink-2);
		line-height: 1.7;
	}

	.cta {
		align-self: flex-start;
		padding: 0.7rem 1.75rem;
		border-radius: 999px;
		border: 2px solid var(--color-accent);
		font-size: 0.875rem;
		font-weight: 500;
	}

	.body-grid {
		display: grid;
		grid-template-columns: 1fr 300px;
		gap: 2.5rem;
		padding: 2.5rem 3rem 5rem;
	}

	.section-title {
		margin: 0 0 1.5rem;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.375rem;
	}

	.empty {
		color: var(--color-ink-2);
	}

	.article-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}

	.widget {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		margin-bottom: 2rem;
	}

	.widget h3 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 0.8rem;
		letter-spacing: 0.1em;
		color: var(--color-ink-2);
	}

	.widget ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.widget li {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--color-hairline);
		font-size: 0.9rem;
	}

	.count {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		background: var(--color-code-bg);
		border-radius: 999px;
		padding: 0.2rem 0.6rem;
	}

	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.tag {
		font-size: 0.75rem;
		color: var(--color-ink-2);
		border: 1px solid var(--color-hairline);
		border-radius: 999px;
		padding: 0.35rem 0.85rem;
	}

	/* Pagination : valeurs de la maquette « Blog » (padding 0 48 80, gap 12px,
	   pastilles de 36px, page active en accent). */
	.pagination {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		padding: 0 3rem 5rem;
	}

	.page-link {
		font-family: var(--font-body);
		font-size: 0.875rem;
		color: var(--color-ink-2);
		text-decoration: none;
	}

	.page-link:hover {
		color: var(--color-ink);
	}

	.page-link.is-disabled {
		opacity: 0.4;
	}

	.page-number {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		border: 1px solid var(--color-hairline);
		background: var(--color-surface);
		font-family: var(--font-body);
		font-size: 0.875rem;
		color: var(--color-ink-2);
		text-decoration: none;
	}

	.page-number:hover {
		border-color: var(--color-accent);
		color: var(--color-ink);
	}

	.page-number.current {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: #fff;
		font-weight: 500;
	}

	@media (max-width: 60rem) {
		.featured-card .cover {
			height: 200px;
		}
		.body-grid {
			grid-template-columns: 1fr;
		}
		.article-grid {
			grid-template-columns: 1fr;
		}
	}

	/* Maquette « Blog (mobile) » : pastilles de 32px, gap 10px, padding
	   0 20px 48px, et libellés réduits aux flèches. */
	@media (max-width: 50rem) {
		.pagination {
			gap: 0.625rem;
			padding: 0 1.25rem 3rem;
		}

		.page-number {
			width: 2rem;
			height: 2rem;
			font-size: 0.8125rem;
		}

		.page-link .label {
			display: none;
		}
	}
</style>
